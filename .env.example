# Local dev defaults. Copy to .env (git-ignored) and change anything you like.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=manga
DB_PORT=55432
DEMO_PASSWORD=demo-password-change-me
# Generated by `make .env` on first run: random per clone. URL-safe (hex), since the
# authenticator password goes into PostgREST's connection URI.
AUTHENTICATOR_PASSWORD=generate
JWT_SECRET=generate
JWT_TTL=12h
API_PORT=3000
API_TEST_PORT=3001
